# MendWise — environment variable NAMES. Copy to .env.local and fill in.
# Never commit values. Never prefix a secret with EXPO_PUBLIC_ (Expo inlines
# those into the public bundle).

# --- Supabase (server only) -------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- AI Gateway (server only; OIDC on Vercel) -------------------------------
AI_GATEWAY_API_KEY=

# --- Segmentation (server only) ---------------------------------------------
FAL_KEY=
# fal-sam3 (default). The legacy replicate-sam2 value is no longer supported.
SEGMENT_PROVIDER=
# Default: wound
SAM3_TEXT_PROMPT=
FUSEGNET_MODAL_URL=
FUSEGNET_AUTH_TOKEN=
# foot (default) | all — when FUSegNet runs as a second opinion
FUSEGNET_TRIGGER=
# 512 (default) — FUSegNet model input side
FUSEGNET_SIZE=

# --- Module API (server only) -----------------------------------------------
# The app's own sandbox key, accepted alongside keys in the api_keys table.
MENDWISE_APP_KEY=
# 1 = periwound-relative tissue classification (Phase 3; off by default)
TISSUE_RELATIVE=

# --- Docs gate (server only) ------------------------------------------------
DOCS_PASSPHRASE=

# --- Client (public — inlined into the bundle) ------------------------------
EXPO_PUBLIC_ASSESSMENT_V2=
# Must equal MENDWISE_APP_KEY. Public by definition: a demo gate, not identity.
EXPO_PUBLIC_MENDWISE_API_KEY=
