{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "node scripts/build-vercel.mjs",
  "outputDirectory": "dist",
  "functions": {
    "api/docs-unlock.ts": {
      "maxDuration": 10
    },
    "api/analyze.ts": {
      "maxDuration": 30
    },
    "api/segment.ts": {
      "maxDuration": 180
    },
    "api/v1/assessments/segment.ts": {
      "maxDuration": 180
    },
    "api/v1/assessments/mask.ts": {
      "maxDuration": 30
    },
    "api/v1/assessments/run.ts": {
      "maxDuration": 300
    },
    "api/v1/assessments/tissue.ts": {
      "maxDuration": 60
    },
    "api/v1/assessments/measure.ts": {
      "maxDuration": 60
    },
    "api/v1/assessments/approve.ts": {
      "maxDuration": 30
    },
    "api/v1/assessments/correction.ts": {
      "maxDuration": 30
    },
    "api/v1/assessments/vlm-features.ts": {
      "maxDuration": 60
    },
    "api/v1/assessments/report.ts": {
      "maxDuration": 60
    },
    "api/v1/assessments/baseline.ts": {
      "maxDuration": 60
    },
    "api/v1/assessments/evaluate.ts": {
      "maxDuration": 30
    },
    "api/v1/assessments/create.ts": {
      "maxDuration": 30
    },
    "api/v1/assessments/health.ts": {
      "maxDuration": 30
    },
    "api/v1/openapi.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(), microphone=(), interest-cohort=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; img-src 'self' data: blob: https://*.fal.media; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
        }
      ]
    }
  ]
}
