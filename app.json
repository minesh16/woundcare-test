{
  "expo": {
    "name": "WoundCare Demo",
    "slug": "woundcare-test",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "woundcaretest",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "edu.latrobe.woundcaredemo",
      "infoPlist": {
        "NSCameraUsageDescription": "WoundCare Demo uses the camera to capture wound photos for research demonstration only.",
        "NSPhotoLibraryUsageDescription": "WoundCare Demo lets you choose an existing wound photo for research demonstration only."
      }
    },
    "android": {
      "package": "edu.latrobe.woundcaredemo",
      "adaptiveIcon": {
        "backgroundColor": "#E6F5F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WoundCare Demo to access your camera for research demonstration photos."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow WoundCare Demo to access your photos for research demonstration."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B2545",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
